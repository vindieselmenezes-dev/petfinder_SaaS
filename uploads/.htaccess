# Esta pasta só guarda arquivos enviados por usuários (fotos de pets,
# empresas, produtos, prestadores). Os controllers já validam o
# conteúdo real de cada upload antes de salvar (getimagesize() + lista
# de extensões permitidas), mas isso é uma segunda camada de defesa:
# mesmo que algum arquivo indevido chegasse a ser salvo aqui por
# qualquer motivo, o servidor nunca deve executá-lo como código — só
# servir como arquivo estático.

<IfModule mod_php.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(php|php\d?|phtml|pht)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
