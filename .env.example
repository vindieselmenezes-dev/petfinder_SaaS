# Copie este arquivo para ".env" e ajuste para o seu ambiente.
# O ".env" real NUNCA deve ser commitado (já está no .gitignore).

DB_HOST=localhost
DB_DATABASE=petfinder
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

APP_ENV=local
APP_DEBUG=true
# Em qualquer valor diferente de "local" (ex: "production"), o site passa a
# forçar HTTPS automaticamente. Não mude isso em ambiente sem certificado.

# Caminho onde o projeto está hospedado (pasta que contém /public, /assets,
# /app, index.html). Deixe em branco se o site estiver na raiz do domínio.
# Ex: se a URL do site é https://seusite.com/petfinder-SaaS/public/login.php,
# use APP_BASE_PATH=/petfinder-SaaS
APP_BASE_PATH=/petfinder-SaaS

# URL completa (com esquema e domínio, sem barra no final) onde o site
# fica publicado. Usada para montar links absolutos quando não dá pra
# confiar no host da requisição: metatags de compartilhamento
# (Seo::tags(), com fallback pro host da requisição se isto ficar em
# branco) e o sitemap.xml quando gerado via linha de comando/cron (onde
# não existe requisição HTTP nenhuma, então não tem host pra usar).
# Ex: APP_URL=https://seusite.com.br  (inclua o APP_BASE_PATH acima, se houver)
APP_URL=

# Para onde vão as mensagens do formulário público de contato
# (public/contato.php). Mesmo sem SMTP configurado (EMAIL_NOTIFICACOES=1),
# toda mensagem fica registrada em /logs/emails.log.
EMAIL_CONTATO=contato@petfinder.com.br

# ----------------------------------------------------------
# E-mail (recuperar senha, código 2FA, contato, notificações)
# ----------------------------------------------------------
# EMAIL_ENVIO=0 só grava em /logs/emails.log (bom para desenvolvimento).
# Com 1, envia de verdade pelo SMTP abaixo: recuperação de senha, código 2FA,
# formulário de contato e confirmação de e-mail.
EMAIL_ENVIO=0
# Com 1, TODA notificação do sistema (pedidos, adoção, chat...) também vira
# e-mail. Gasta muito do limite diário do provedor; o push já avisa o celular.
# Para os e-mails essenciais, deixe EMAIL_ENVIO=1 e este em 0.
EMAIL_NOTIFICACOES=0

# Remetente. No Brevo precisa ser um remetente/domínio VALIDADO
# (Brevo > Remetentes, domínios e IPs dedicados), senão o envio é recusado.
EMAIL_REMETENTE=

# Brevo: Brevo > SMTP e API > aba SMTP.
# SMTP_USERNAME é o "Login" mostrado lá (algo como xxxx@smtp-brevo.com),
# e NÃO o e-mail da sua conta. SMTP_PASSWORD é a "Chave SMTP" (gere uma
# nova em "Gerar uma nova chave SMTP"), NÃO a senha da conta.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_AUTH=1
SMTP_USERNAME=
SMTP_PASSWORD=

# ----------------------------------------------------------
# Notificações push (aviso no celular/navegador)
# ----------------------------------------------------------
# Gere as chaves com:  php scripts/gerar_vapid.php
# A chave privada é segredo: fica só no .env do servidor, nunca no GitHub.
# SUBJECT: um mailto: seu ou a URL do site (o serviço de push usa para contato).
# Sem estas 3 variáveis, o push simplesmente não é enviado.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=

# ----------------------------------------------------------
# Confirmação de e-mail no cadastro
# ----------------------------------------------------------
# 1 (padrão): a conta só consegue entrar depois de clicar no link enviado por
# e-mail. Exige o SMTP acima funcionando em produção; sem ele, ninguém novo
# consegue entrar. Use 0 para desligar a exigência (o link ainda é enviado).
# Antes de ligar: rode database/migration_029_confirmacao_email.sql.
EXIGIR_CONFIRMACAO_EMAIL=1

# Chave secreta usada para assinar links (hoje: o link de "descadastrar"
# da newsletter). Gere uma própria por ambiente, nunca reaproveite esta
# nem deixe em branco em produção. Sugestão pra gerar:
#   php -r "echo bin2hex(random_bytes(32));"
APP_KEY=


# Proxies/CDN/balanceadores que ficam NA FRENTE do site (IPs ou faixas CIDR,
# separados por vírgula). O sistema usa o IP do visitante para limitar
# tentativas de login, recuperação de senha, 2FA, contato etc. O cabeçalho
# X-Forwarded-For é escrito por quem faz a requisição, então só é aceito
# quando a conexão vem de um destes endereços.
#  - Site servido direto pelo Apache/Nginx (sem proxy/CDN): deixe VAZIO.
#  - Atrás de proxy/CDN: liste os IPs dele. Se esquecer, todos os visitantes
#    passam a parecer ter o IP do proxy e os limites valem para o site inteiro.
# Exemplo: TRUSTED_PROXIES=10.0.0.5,172.16.0.0/12
TRUSTED_PROXIES=
